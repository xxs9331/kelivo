diff --git a/ds-bot/src/host/kelivo-sync.js b/ds-bot/src/host/kelivo-sync.js
new file mode 100644
index 0000000..d192ed0
--- /dev/null
+++ b/ds-bot/src/host/kelivo-sync.js
@@ -0,0 +1,371 @@
+// Device-local sync credentials and receipts never enter Bot team state or prompts.
+import { randomUUID } from 'node:crypto'
+import { chmodSync, closeSync, existsSync, mkdirSync, openSync } from 'node:fs'
+import { isIP } from 'node:net'
+import { join } from 'node:path'
+import { DatabaseSync } from 'node:sqlite'
+
+const fail = code => Object.assign(new Error(`Kelivo sync: ${code}`), { code: 'bot/refused' })
+const keyOf = record => `${record.kind}:${record.id}`
+const newer = (a, b) => !b || a.updatedAt > b.updatedAt || (a.updatedAt === b.updatedAt && a.originDevice > b.originDevice)
+const textOf = content => (content ?? []).filter(block => block.type === 'text').map(block => block.text).join('\n')
+const tagOf = event => event.data?.kelivoSync ?? (event.data?.source ?? event.data?.message?.source)?.kelivoSync
+
+// DSH's public projection API preserves the recorded message's identity and role.
+export const syncEdit = {
+  type: 'ds-bot/sync-edit',
+  project(event, context) {
+    const { targetSeq, content } = event.data
+    if (!Number.isSafeInteger(targetSeq) || !context.nodes.includes(targetSeq) || !Array.isArray(content)
+      || content.some(block => block.type !== 'text' || typeof block.text !== 'string')) throw fail('invalid_edit')
+    const original = context.events[targetSeq - context.baseSeq]
+    const message = context.messages.get(targetSeq) ?? (original.type === 'user/message' ? original.data : original.data.message)
+    if (!message || !['user', 'assistant'].includes(message.role)) throw fail('invalid_edit_target')
+    return new Map([[targetSeq, { ...message, content }]])
+  },
+}
+
+export function syncUrl(value, localHttp = false) {
+  let url
+  try { url = new URL(value) } catch { throw fail('invalid_server_url') }
+  const host = url.hostname.replace(/^\[|\]$/g, '')
+  const octets = host.split('.').map(Number)
+  const local = host === 'localhost' || host === '::1' || (isIP(host) === 4 && (
+    octets[0] === 127 || octets[0] === 10 || (octets[0] === 192 && octets[1] === 168)
+    || (octets[0] === 172 && octets[1] >= 16 && octets[1] <= 31)))
+  if (url.username || url.password || url.search || url.hash || (url.protocol !== 'https:' && !(localHttp && local && url.protocol === 'http:'))) throw fail('https_required')
+  return url.href.replace(/\/$/, '')
+}
+
+function validate(record) {
+  if (!record || !['conversation', 'message'].includes(record.kind) || typeof record.id !== 'string'
+    || !record.id || record.id.length > 200 || !Number.isSafeInteger(record.updatedAt) || record.updatedAt <= 0
+    || typeof record.originDevice !== 'string' || !record.originDevice || typeof record.deleted !== 'boolean') throw fail('invalid_record')
+  if (record.deleted) return record
+  const p = record.payload
+  if (!p || p.id !== record.id || Buffer.byteLength(JSON.stringify(p)) > 1024 * 1024) throw fail('invalid_payload')
+  if (record.kind === 'conversation') {
+    if (typeof p.title !== 'string' || !Number.isFinite(Date.parse(p.createdAt)) || !Array.isArray(p.messageIds)) throw fail('invalid_conversation')
+  } else if (typeof p.conversationId !== 'string' || !['user', 'assistant'].includes(p.role)
+    || p.isStreaming !== false || !Number.isFinite(Date.parse(p.timestamp)) || !Array.isArray(p.parts)
+    || p.parts.some(part => typeof part.kind !== 'string' || typeof part.payload !== 'string')) throw fail('invalid_message')
+  return record
+}
+
+export function createSync(rt) {
+  if (typeof rt.ctx.sessions?.registerMessageProjection !== 'function') throw fail('requires_dsh_0.2.0_rc2')
+  const file = join(rt.home, 'kelivo-sync.sqlite')
+  mkdirSync(rt.home, { recursive: true })
+  closeSync(openSync(file, 'a', 0o600))
+  for (const path of [file, `${file}-wal`, `${file}-shm`]) {
+    try { chmodSync(path, 0o600) } catch (error) { if (error.code !== 'ENOENT') throw error }
+  }
+  const db = new DatabaseSync(file)
+  db.exec(`PRAGMA journal_mode=WAL; PRAGMA synchronous=FULL;
+    CREATE TABLE IF NOT EXISTS meta (key TEXT PRIMARY KEY,value TEXT NOT NULL);
+    CREATE TABLE IF NOT EXISTS records (key TEXT PRIMARY KEY,json TEXT NOT NULL);
+    CREATE TABLE IF NOT EXISTS bindings (bot TEXT PRIMARY KEY,conversation TEXT UNIQUE NOT NULL,name TEXT NOT NULL);
+    CREATE TABLE IF NOT EXISTS exports (id TEXT PRIMARY KEY,conversation TEXT NOT NULL);
+    CREATE TABLE IF NOT EXISTS outbox (id INTEGER PRIMARY KEY CHECK(id=1),json TEXT NOT NULL);`)
+  const get = key => { const value = db.prepare('SELECT value FROM meta WHERE key=?').get(key)?.value; return value === undefined ? undefined : JSON.parse(value) }
+  const set = (key, value) => db.prepare('INSERT OR REPLACE INTO meta VALUES (?,?)').run(key, JSON.stringify(value))
+  const all = () => db.prepare('SELECT json FROM records').all().map(row => JSON.parse(row.json))
+  const recordOf = key => { const row = db.prepare('SELECT json FROM records WHERE key=?').get(key); return row && JSON.parse(row.json) }
+  const store = record => { validate(record); if (newer(record, recordOf(keyOf(record)))) db.prepare('INSERT OR REPLACE INTO records VALUES (?,?)').run(keyOf(record), JSON.stringify(record)) }
+  const bindings = () => db.prepare('SELECT * FROM bindings').all()
+  const device = get('device') ?? randomUUID()
+  set('device', device)
+  let operation
+  let closed = false
+  let lastError = null
+  let lastSuccess = null
+  const exclusive = task => {
+    if (closed) return Promise.reject(fail('stopped'))
+    if (operation) return Promise.reject(fail('busy'))
+    operation = Promise.resolve().then(task).catch(error => {
+      // Fetch and server error bodies may contain credentials. Only fixed codes leave here.
+      lastError = error?.code === 'bot/refused' ? error.message : 'Kelivo sync: operation_failed'
+      throw fail(lastError.replace(/^Kelivo sync: /, ''))
+    }).finally(() => { operation = undefined })
+    return operation
+  }
+  async function request(path, body, config = get('connection')) {
+    if (!config) throw fail('not_paired')
+    let response
+    try {
+      response = await fetch(`${config.url}${path}`, {
+        method: body === undefined ? 'GET' : 'POST', redirect: 'error', signal: AbortSignal.timeout(30_000),
+        headers: { 'content-type': 'application/json', 'X-Device-Id': device, ...(config.token ? { authorization: `Bearer ${config.token}` } : {}) },
+        ...(body === undefined ? {} : { body: JSON.stringify(body) }),
+      })
+    } catch { throw fail('network_failed') }
+    if (!response.ok) { await response.body?.cancel(); throw fail(`http_${response.status}`) }
+    const chunks = []
+    let size = 0
+    for await (const chunk of response.body) {
+      size += chunk.length
+      if (size > 32 * 1024 * 1024) throw fail('response_too_large')
+      chunks.push(chunk)
+    }
+    try { return JSON.parse(Buffer.concat(chunks).toString('utf8')) } catch { throw fail('invalid_response') }
+  }
+  const status = () => ({
+    paired: Boolean(get('connection')?.token), enabled: get('enabled') === true,
+    server: get('connection')?.url ?? '', busy: Boolean(operation), lastError, lastSuccess,
+    bindings: bindings().map(binding => ({ botId: binding.bot, conversationId: binding.conversation,
+      title: recordOf(`conversation:${binding.conversation}`)?.payload?.title ?? binding.name,
+      deleted: recordOf(`conversation:${binding.conversation}`)?.deleted === true })),
+    conversations: all().filter(r => r.kind === 'conversation' && !r.deleted && !bindings().some(b => b.conversation === r.id))
+      .map(r => ({ id: r.id, title: r.payload.title })),
+  })
+  async function pull() {
+    for (;;) {
+      const cursor = get('cursor') ?? 0
+      const page = await request(`/v1/changes?cursor=${cursor}&limit=500`)
+      if (!Array.isArray(page.changes) || typeof page.hasMore !== 'boolean' || !Number.isSafeInteger(page.nextCursor)
+        || page.nextCursor < cursor || (page.hasMore && page.changes.length === 0)) throw fail('invalid_page')
+      let seq = cursor
+      for (const record of page.changes) {
+        validate(record)
+        if (!Number.isSafeInteger(record.serverSeq) || record.serverSeq <= seq) throw fail('invalid_sequence')
+        seq = record.serverSeq
+      }
+      if (page.nextCursor !== seq) throw fail('invalid_cursor')
+      db.exec('BEGIN')
+      try { for (const record of page.changes) store(record); set('cursor', seq); db.exec('COMMIT') }
+      catch (error) { db.exec('ROLLBACK'); throw error }
+      if (!page.hasMore) return
+    }
+  }
+  async function push() {
+    const queued = db.prepare('SELECT json FROM outbox WHERE id=1').get()
+    if (!queued) return
+    const body = JSON.parse(queued.json)
+    const result = await request('/v1/changes', body)
+    if (!Array.isArray(result.applied) || !Array.isArray(result.superseded)) throw fail('invalid_receipt')
+    const pending = new Map(body.records.map(r => [keyOf(r), r]))
+    const winners = []
+    for (const receipt of [...result.applied, ...result.superseded]) {
+      const key = keyOf(receipt)
+      const sent = pending.get(key)
+      if (!sent) throw fail('invalid_receipt')
+      if (receipt.winner) { validate(receipt.winner); if (keyOf(receipt.winner) !== key) throw fail('invalid_winner') }
+      else if (receipt.status !== 'applied' && receipt.status !== 'duplicate') throw fail('missing_winner')
+      winners.push(receipt.winner ?? sent)
+      pending.delete(key)
+    }
+    if (pending.size) throw fail('incomplete_receipt')
+    db.exec('BEGIN')
+    try { for (const winner of winners) store(winner); db.exec('DELETE FROM outbox'); db.exec('COMMIT') }
+    catch (error) { db.exec('ROLLBACK'); throw error }
+    // Push ACKs never move the pull cursor.
+  }
+  async function queue(records) {
+    let batch = []
+    let bytes = 0
+    for (const record of records) {
+      validate(record)
+      const size = Buffer.byteLength(JSON.stringify(record))
+      if (batch.length && (batch.length === 500 || bytes + size > 14 * 1024 * 1024)) { await send(); batch = []; bytes = 0 }
+      batch.push({ kind: record.kind, id: record.id, updatedAt: record.updatedAt, originDevice: device,
+        deleted: record.deleted, payload: record.payload }); bytes += size
+    }
+    if (batch.length) await send()
+    async function send() {
+      db.prepare('INSERT INTO outbox VALUES (1,?)').run(JSON.stringify({ deviceId: device, changeId: randomUUID(), records: batch }))
+      await push()
+    }
+  }
+  async function exportChats() {
+    for (const binding of bindings()) {
+      const conversation = recordOf(`conversation:${binding.conversation}`)
+      if (conversation?.deleted) continue
+      const bot = rt.botOf(binding.bot)
+      if (!bot) {
+        await queue([{ kind: 'conversation', id: binding.conversation, updatedAt: Math.max(Date.now() * 1000, (conversation?.updatedAt ?? 0) + 1), originDevice: device, deleted: true, payload: null }])
+        continue
+      }
+      if (bot.name !== binding.name && conversation) {
+        await queue([{ ...conversation, updatedAt: Math.max(Date.now() * 1000, conversation.updatedAt + 1), originDevice: device,
+          payload: { ...conversation.payload, title: bot.name } }])
+        db.prepare('UPDATE bindings SET name=? WHERE bot=?').run(bot.name, bot.id)
+      }
+      const records = []
+      const exported = []
+      const sessions = [...(bot.segments ?? []).map(s => s.sessionId), rt.chatOf(bot.id)]
+      for (const sessionId of sessions) {
+        const agent = await rt.resolveAgent(sessionId)
+        if (agent.status !== 'idle') throw fail('bot_is_running')
+        let keep = false
+        const hidden = new Set(rt.state.exchangeTurns[sessionId] ?? [])
+        for (const event of await eventsOf(agent)) {
+          const message = event.type === 'user/message' ? event.data : event.data?.message
+          if (message?.source?.kelivoSync || event.surfaceOp !== 'append') continue
+          const entry = rt.historyEntry(event, false)
+          if (entry && !entry.answer) keep = entry.keepAnswers
+          if (!entry || !entry.text || (entry.answer && (!keep || hidden.has(event.data.turn)))) continue
+          // Question cards and tools stay on DSH; only actual user/assistant messages cross.
+          if (!['user/message', 'assistant/message'].includes(event.type) || typeof message?.id !== 'string') continue
+          const id = `dsh:${sessionId}:${message.id}`
+          if (db.prepare('SELECT 1 FROM exports WHERE id=?').get(id)) continue
+          const previous = recordOf(`message:${id}`)
+          if (!previous) records.push({ kind: 'message', id, updatedAt: event.time * 1000, originDevice: device, deleted: false,
+            payload: { id, conversationId: binding.conversation, role: entry.answer ? 'assistant' : 'user', content: '',
+              parts: [{ kind: 'text', payload: entry.text }], timestamp: new Date(event.time).toISOString(), isStreaming: false,
+              version: 0, groupId: id, modelId: message.source?.model ?? null, providerId: null } })
+          exported.push(id)
+        }
+      }
+      // An export marker is only committed after its durable outbox has been acknowledged.
+      await queue(records)
+      for (const id of exported) db.prepare('INSERT OR IGNORE INTO exports VALUES (?,?)').run(id, binding.conversation)
+    }
+  }
+  async function eventsOf(agent) {
+    await rt.ctx.sessions.flush(agent.session)
+    const events = []
+    for await (const event of rt.eventsBackwards(agent.id, AbortSignal.timeout(30_000), Infinity)) events.push(event)
+    return events.sort((a, b) => a.seq - b.seq)
+  }
+  async function importChats() {
+    const records = all()
+    for (const binding of bindings()) {
+      if (!rt.botOf(binding.bot)) continue
+      const conversation = recordOf(`conversation:${binding.conversation}`)
+      if (conversation?.deleted) continue // A phone chat deletion does not destroy a Bot's identity or tools.
+      const agents = []
+      const bot = rt.botOf(binding.bot)
+      for (const id of [...(bot.segments ?? []).map(s => s.sessionId), rt.chatOf(bot.id)]) agents.push(await rt.resolveAgent(id))
+      if (agents.some(agent => agent.status !== 'idle')) throw fail('bot_is_running')
+      const current = agents.at(-1)
+      const byId = new Map()
+      const byGroup = new Map()
+      const native = new Map()
+      const index = (agent, event) => {
+        const entry = { agent, event }
+        const tag = tagOf(event)
+        if (tag) { byId.set(tag.id, entry); byGroup.set(tag.groupId ?? tag.id, entry) }
+        const message = event.type === 'user/message' ? event.data : event.data?.message
+        if (message?.id && !tag) native.set(`dsh:${agent.session.id}:${message.id}`, entry)
+      }
+      for (const agent of agents) for (const event of await eventsOf(agent)) index(agent, event)
+      const exported = new Set(db.prepare('SELECT id FROM exports WHERE conversation=?').all(binding.conversation).map(row => row.id))
+      const remote = records.filter(r => r.kind === 'message' && (r.payload?.conversationId === binding.conversation
+        || byId.has(r.id) || exported.has(r.id)))
+        .sort((a, b) => Date.parse(a.payload?.timestamp ?? '') - Date.parse(b.payload?.timestamp ?? '') || a.id.localeCompare(b.id))
+      await current.runMaintenance(async () => {
+        for (const record of remote) {
+          const p = record.payload
+          if (!record.deleted && p.groupId && conversation?.payload?.selectedRevisions?.[p.groupId]
+            && conversation.payload.selectedRevisions[p.groupId] !== record.id) continue
+          const group = p?.groupId ?? tagOf(byId.get(record.id)?.event ?? {})?.groupId ?? record.id
+          const found = (record.deleted ? byId.get(record.id) : byGroup.get(group)) ?? byId.get(record.id) ?? native.get(record.id)
+          if (record.deleted && byGroup.has(group) && tagOf(byGroup.get(group).event)?.id !== record.id) continue
+          const mark = found && tagOf(found.event)
+          if (mark?.id === record.id && !newer(record, mark)) continue
+          if (found && !mark && record.originDevice === device && record.updatedAt === found.event.time * 1000) continue
+          if (record.deleted && !found) continue
+          const session = found?.agent.session ?? current.session
+          const targetSeq = found?.event.data?.targetSeq ?? found?.event.seq
+          const canReplace = found && found.agent === current && session.surface.nodes.includes(targetSeq)
+          const tag = { id: record.id, groupId: group, conversationId: binding.conversation, updatedAt: record.updatedAt, originDevice: record.originDevice }
+          const content = [{ type: 'text', text: record.deleted ? '[Message deleted on Kelivo]' : p.parts.filter(part => part.kind === 'text').map(part => part.payload).join('\n') || p.content || '[Attachment: available on the source device]' }]
+          let event
+          if (canReplace) {
+            event = session.append('ds-bot/sync-edit', { targetSeq, content, kelivoSync: tag })
+          } else if (found) {
+            // shortcut: compacted history cannot be rewritten; append an explicit correction to the active part.
+            event = current.session.append('user/message', { id: randomUUID(), role: 'user', content: [{ type: 'text', text: record.deleted
+              ? `[Synced correction] Earlier message ${record.id} was deleted on Kelivo. Do not rely on it.`
+              : `[Synced correction] Earlier message ${record.id} now reads:\n${textOf(content)}` }],
+              source: { kind: 'plugin', plugin: 'ds-bot', form: 'notice', summary: 'Kelivo updated an earlier message', kelivoSync: tag } }, { surfaceOp: 'append' })
+          } else if (p.role === 'assistant') {
+            const time = Date.parse(p.timestamp)
+            event = session.append('assistant/message', { turn: 0, step: 0, stream: [
+              { type: 'chunk', time, chunk: { type: 'block-start', index: 0, blockType: 'text' } },
+              { type: 'text-chunks', time0: time, index: 0, dt: [0], texts: [textOf(content)] },
+              { type: 'chunk', time, chunk: { type: 'block-end', index: 0, block: content[0] } },
+              { type: 'chunk', time, chunk: { type: 'finish', reason: { kind: 'stop' } } },
+            ], message: { id: record.id, role: 'assistant', content,
+              source: { kind: 'model', provider: 'kelivo-sync', model: p.modelId ?? 'remote', kelivoSync: tag } } }, { surfaceOp: 'append' })
+          } else event = session.append('user/message', { id: record.id, role: 'user', content, source: { kind: 'user', kelivoSync: tag } }, { surfaceOp: 'append' })
+          index(current, event)
+          await rt.ctx.sessions.flush(current.session)
+        }
+      })
+    }
+  }
+  async function sync() {
+    await rt.load()
+    if (rt.readOnly() !== undefined) throw fail('read_only')
+    await push()
+    await pull()
+    await exportChats()
+    await pull()
+    await importChats()
+    lastError = null; lastSuccess = new Date().toISOString()
+    return status()
+  }
+  async function share(botId) {
+    await rt.load()
+    const bot = rt.botOf(botId)
+    if (!bot || bindings().some(b => b.bot === botId)) throw fail('invalid_bot')
+    const id = randomUUID()
+    const time = new Date(bot.createdAt).toISOString()
+    const record = { kind: 'conversation', id, originDevice: device, updatedAt: Date.now() * 1000, deleted: false,
+      payload: { id, title: bot.name, createdAt: time, updatedAt: time, messageIds: [], versionSelections: {}, selectedRevisions: {}, extras: {} } }
+    await queue([record])
+    db.prepare('INSERT INTO bindings VALUES (?,?,?)').run(botId, id, bot.name)
+    return sync()
+  }
+  async function importConversation(id) {
+    await sync()
+    const record = recordOf(`conversation:${id}`)
+    if (!record || record.deleted || bindings().some(b => b.conversation === id)) throw fail('invalid_conversation')
+    let name = 'Phone chat'
+    let suffix = 1
+    while (rt.findBot(name)) name = `Phone chat ${++suffix}`
+    const bot = await rt.createBot({ name, pickModel: true })
+    rt.dropKickoff(bot.id)
+    db.prepare('INSERT INTO bindings VALUES (?,?,?)').run(bot.id, id, bot.name)
+    await importChats()
+    return status()
+  }
+  return {
+    status,
+    run: () => exclusive(sync),
+    share: id => exclusive(() => share(id)),
+    importConversation: id => exclusive(() => importConversation(id)),
+    pair: body => exclusive(async () => {
+      const url = syncUrl(body.server, body.localHttp === true)
+      if (typeof body.code !== 'string' || !body.code.trim() || body.code.length > 200) throw fail('invalid_pair_code')
+      const paired = await request('/v1/pair/claim', { deviceId: device, deviceName: 'DS Bot', platform: 'dsh', code: body.code.trim() }, { url })
+      if (typeof paired.deviceToken !== 'string' || !paired.deviceToken || typeof paired.serverId !== 'string') throw fail('invalid_pair_response')
+      if (get('serverId') && get('serverId') !== paired.serverId) throw fail('different_server_requires_fresh_sync_database')
+      set('connection', { url, token: paired.deviceToken }); set('serverId', paired.serverId); set('enabled', true)
+      return sync()
+    }),
+    disconnect: () => exclusive(async () => { set('enabled', false); set('connection', null); return status() }),
+    close: async () => { closed = true; await operation?.catch(() => {}); db.close() },
+    enabled: () => get('enabled') === true,
+  }
+}
+
+export function install(rt) {
+  let service
+  let timer
+  rt.kelivoSync = () => (service ??= createSync(rt))
+  rt.ctx.effect(() => rt.ctx.sessions?.registerMessageProjection?.(syncEdit), 'ds-bot: Kelivo message edits')
+  rt.ctx.effect(() => {
+    if (existsSync(join(rt.home, 'kelivo-sync.sqlite'))) {
+      service = createSync(rt)
+      if (service.enabled()) void service.run().catch(() => {})
+    }
+    timer = setInterval(() => {
+      // Lazily open only after the user visits Sync; ordinary users get no extra files or work.
+      if (service?.enabled()) void service.run().catch(() => {})
+    }, 60_000)
+    timer.unref?.()
+    return async () => { clearInterval(timer); await service?.close() }
+  }, 'ds-bot: Kelivo sync')
+}
