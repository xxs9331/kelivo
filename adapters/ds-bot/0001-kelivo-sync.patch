@@ -0,0 +1,115 @@
+// Run after bench.sh: a real DSH model request -> Go sync -> Kelivo model request.
+import assert from 'node:assert/strict'
+import { execFile, spawn } from 'node:child_process'
+import { randomUUID } from 'node:crypto'
+import { readFileSync } from 'node:fs'
+import { createServer } from 'node:net'
+import { dirname, join, resolve } from 'node:path'
+import { setTimeout as delay } from 'node:timers/promises'
+import { promisify } from 'node:util'
+
+const [name, port] = process.argv.slice(2)
+assert.match(name ?? '', /^[a-z0-9-]+$/)
+assert.match(port ?? '', /^\d+$/)
+const home = resolve(import.meta.dirname, '../..', `.dsh-test-${name}`)
+const base = `http://127.0.0.1:${port}`
+const loginUrl = readFileSync(join(home, 'web.log'), 'utf8').match(/http:\/\/127\.0\.0\.1:\d+\/\?token=\S+/)?.[0]
+assert.ok(loginUrl, 'bench login URL missing')
+const login = await fetch(loginUrl, { redirect: 'manual' })
+const cookie = login.headers.getSetCookie().map(value => value.split(';')[0]).join('; ')
+assert.ok(cookie, 'bench login failed')
+async function api(endpoint, payload = {}) {
+  const response = await fetch(`${base}/api/bot`, { method: 'POST', headers: { cookie, 'content-type': 'application/json' }, body: JSON.stringify({ endpoint, payload }) })
+  const result = await response.json()
+  assert.equal(result.ok, true, `${endpoint}: ${result.error?.code}`)
+  return result.value
+}
+const logs = () => {
+  try { return readFileSync(join(home, 'mock.jsonl'), 'utf8').split('\n').filter(Boolean).map(line => JSON.parse(line)) }
+  catch (error) { if (error.code === 'ENOENT') return []; throw error }
+}
+async function quiet() {
+  const deadline = Date.now() + 60_000
+  let previous = -1
+  let stable = Date.now()
+  while (Date.now() < deadline) {
+    const state = await api('state')
+    const count = logs().length
+    if (count !== previous || Object.keys(state.activity).length) { previous = count; stable = Date.now() }
+    else if (Date.now() - stable > 1000) return
+    await delay(100)
+  }
+  throw new Error('bench did not become idle')
+}
+await quiet()
+const reserve = createServer()
+await new Promise(resolve => reserve.listen(0, '127.0.0.1', resolve))
+const syncPort = reserve.address().port
+await new Promise(resolve => reserve.close(resolve))
+const binary = process.env.KELIVO_SYNC_SERVER_BINARY
+assert.ok(binary, 'KELIVO_SYNC_SERVER_BINARY is required')
+const db = join(home, 'bot', 'sync-smoke-server.sqlite')
+const server = spawn(binary, ['-db', db, '-addr', `127.0.0.1:${syncPort}`], { stdio: 'ignore' })
+const url = `http://127.0.0.1:${syncPort}`
+const exec = promisify(execFile)
+try {
+  const deadline = Date.now() + 30_000
+  for (;;) {
+    try { if ((await fetch(`${url}/health`)).ok) break } catch {}
+    if (Date.now() > deadline) throw new Error('sync server did not start')
+    await delay(50)
+  }
+  const pairCode = async () => (await exec(binary, ['-db', db, 'pair-code'])).stdout.trim()
+  const deviceId = randomUUID()
+  const claim = await fetch(`${url}/v1/pair/claim`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ code: await pairCode(), deviceId, deviceName: 'Phone fixture', platform: 'test' }) }).then(r => r.json())
+  assert.ok(claim.deviceToken, 'phone fixture could not pair')
+  const id = randomUUID()
+  const userMarker = `PHONE_USER_${randomUUID()}`
+  const assistantMarker = `PHONE_ASSISTANT_${randomUUID()}`
+  const time = new Date().toISOString()
+  const records = [
+    { kind: 'conversation', id, updatedAt: Date.now() * 1000, originDevice: deviceId, deleted: false,
+      payload: { id, title: 'Phone context smoke', createdAt: time, updatedAt: time, messageIds: [], versionSelections: {}, selectedRevisions: {}, extras: {} } },
+    ...[['user', userMarker], ['assistant', assistantMarker]].map(([role, value], index) => {
+      const messageId = randomUUID()
+      return { kind: 'message', id: messageId, originDevice: deviceId, updatedAt: Date.now() * 1000, deleted: false,
+        payload: { id: messageId, conversationId: id, role, parts: [{ kind: 'text', payload: value }], content: '', timestamp: new Date(Date.now() + index).toISOString(), isStreaming: false, version: 0, groupId: messageId } }
+    }),
+  ]
+  const pushed = await fetch(`${url}/v1/changes`, { method: 'POST', headers: { authorization: `Bearer ${claim.deviceToken}`, 'content-type': 'application/json' },
+    body: JSON.stringify({ deviceId, changeId: randomUUID(), records }) })
+  assert.equal(pushed.status, 200, 'phone fixture push failed')
+  const count = logs().length
+  await api('sync-pair', { server: url, code: await pairCode(), localHttp: true })
+  const imported = await api('sync-import', { conversationId: id })
+  const botId = imported.bindings.find(link => link.conversationId === id).botId
+  const roster = await api('state')
+  const model = roster.models.find(entry => entry.ref.endsWith('/deepseek-flash'))?.ref
+  assert.ok(model, 'mock DeepSeek model missing')
+  await api('update-bot', { id: botId, model })
+  await quiet()
+  assert.equal(logs().length, count, 'sync or model selection unexpectedly ran a Bot')
+  console.log('ok: sync imports both roles without any model or tool execution')
+  for (const marker of [userMarker, assistantMarker]) {
+    const before = logs().length
+    await api('send', { sessionId: botId, text: `上下文里有 ${marker}` })
+    await quiet()
+    const calls = logs().slice(before)
+    assert.ok(calls.some(call => call.out?.some(block => block.text === `上下文里有「${marker}」。`)), 'actual model request lost synced history')
+  }
+  await api('sync-run')
+  console.log('ok: actual DSH model requests contain the phone user and assistant history')
+  const flutter = process.env.FLUTTER_BIN
+  assert.ok(flutter, 'FLUTTER_BIN is required for the reverse model-request check')
+  const kelivo = process.env.KELIVO_REPO ?? resolve(dirname(home), '../kelivo')
+  const check = await exec(flutter, ['test', 'test/core/services/sync/kelivo_dsh_model_request_test.dart', '--no-pub', '--reporter', 'expanded'], {
+    cwd: kelivo, timeout: 120_000, maxBuffer: 1024 * 1024,
+    env: { ...process.env, KELIVO_DSH_SYNC_URL: url, KELIVO_DSH_PAIR_CODE: await pairCode(),
+      KELIVO_DSH_CONVERSATION: id, KELIVO_DSH_USER_MARKER: userMarker, KELIVO_DSH_ASSISTANT_MARKER: assistantMarker },
+  })
+  assert.ok(check.stdout.includes('All tests passed!'), 'Kelivo reverse check did not pass')
+  console.log('ok: actual Kelivo model request contains the synced DSH replies; both sides can continue')
+} finally {
+  server.kill()
+  await new Promise(resolve => server.once('exit', resolve))
+}
