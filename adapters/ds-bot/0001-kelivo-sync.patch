+import assert from 'node:assert/strict'
+import { execFile, spawn } from 'node:child_process'
+import { mkdtempSync, rmSync, statSync } from 'node:fs'
+import { createServer } from 'node:net'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { promisify } from 'node:util'
+import { setTimeout as delay } from 'node:timers/promises'
+import { test } from 'node:test'
+import { Session } from '@deepseek-ai/dsh-session'
+import { createUserMessage, createAssistantMessage } from '@deepseek-ai/dsh-llm'
+import { createSync, syncEdit, syncUrl } from '../src/host/kelivo-sync.js'
+import { historyEntry } from '../src/host/parts.js'
+
+const exec = promisify(execFile)
+const content = text => [{ type: 'text', text }]
+const text = message => message.content.map(block => block.text ?? '').join('')
+function assistant(session, value) {
+  return session.append('assistant/message', { turn: 1, step: 1, stream: [
+    { type: 'chunk', time: Date.now(), chunk: { type: 'block-end', index: 0, block: content(value)[0] } },
+    { type: 'chunk', time: Date.now(), chunk: { type: 'finish', reason: { kind: 'stop' } } },
+  ], message: createAssistantMessage({ content: content(value), source: { provider: 'mock', model: 'mock' } }) }, { surfaceOp: 'append' })
+}
+
+test('sync accepts HTTPS, permits only explicit local HTTP and refuses URL credentials', () => {
+  assert.equal(syncUrl('https://sync.example.com/'), 'https://sync.example.com')
+  for (const url of ['http://127.0.0.1', 'ftp://localhost', 'https://user:password@example.com', 'https://example.com?secret=x']) assert.throws(() => syncUrl(url))
+  for (const url of ['http://example.com', 'http://192.169.1.1', 'http://172.32.1.1']) assert.throws(() => syncUrl(url, true))
+  assert.equal(syncUrl('http://127.0.0.1:8787', true), 'http://127.0.0.1:8787')
+})
+
+test('a logged sync edit changes model context, preserves roles and replays after restart', () => {
+  const session = Session.create('projection-test', [], undefined, undefined, [syncEdit])
+  const original = assistant(session, 'old reply')
+  session.append('ds-bot/sync-edit', { targetSeq: original.seq, content: content('new reply') })
+  assert.deepEqual(session.deriveMessages().map(m => [m.role, text(m)]), [['assistant', 'new reply']])
+  assert.equal(session.deriveMessages()[0].id, original.data.message.id)
+  const restored = Session.create('projection-test', session.snapshotEvents(), undefined, undefined, [syncEdit])
+  assert.equal(text(restored.deriveMessages()[0]), 'new reply')
+  assert.throws(() => restored.append('ds-bot/sync-edit', { targetSeq: 999, content: content('bad') }))
+})
+
+test('real Go server: both roles cross devices, edits affect context and lost ACKs survive restart without waking a Bot',
+  { skip: !process.env.KELIVO_SYNC_SERVER_BINARY, timeout: 60_000 }, async t => {
+    const root = mkdtempSync(join(tmpdir(), '.dsh-test-sync-'))
+    const binary = process.env.KELIVO_SYNC_SERVER_BINARY
+    const listener = createServer()
+    await new Promise(resolve => listener.listen(0, '127.0.0.1', resolve))
+    const port = listener.address().port
+    await new Promise(resolve => listener.close(resolve))
+    const db = join(root, 'server.sqlite')
+    const server = spawn(binary, ['-db', db, '-addr', `127.0.0.1:${port}`], { stdio: 'ignore' })
+    const url = `http://127.0.0.1:${port}`
+    let bridge
+    t.after(async () => { await bridge?.close(); server.kill(); await new Promise(resolve => server.once('exit', resolve)); rmSync(root, { recursive: true, force: true }) })
+    const started = Date.now()
+    for (;;) {
+      try { if ((await fetch(`${url}/health`)).ok) break } catch {}
+      if (Date.now() - started > 30_000) throw new Error('test server did not start')
