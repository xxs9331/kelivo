+import { createElement as h, useEffect, useState } from 'react'
+import { call } from './api.js'
+import { t } from './i18n.js'
+
+export function KelivoSyncPage({ roster }) {
+  const [status, setStatus] = useState(null)
+  const [error, setError] = useState('')
+  const [busy, setBusy] = useState(false)
+  const [server, setServer] = useState('')
+  const [code, setCode] = useState('')
+  const [localHttp, setLocalHttp] = useState(false)
+  const [bot, setBot] = useState('')
+  const [conversation, setConversation] = useState('')
+  useEffect(() => {
+    const controller = new AbortController()
+    const refresh = () => { void call('sync-status', {}, controller.signal).then(value => {
+      setStatus(value); setServer(current => current || value.server)
+    }).catch(reason => { if (!controller.signal.aborted) setError(reason.message) }) }
+    refresh()
+    const timer = setInterval(refresh, 15_000)
+    return () => { clearInterval(timer); controller.abort() }
+  }, [])
+  async function run(endpoint, payload = {}) {
+    setBusy(true); setError('')
+    try { setStatus(await call(endpoint, payload)); if (endpoint === 'sync-pair') setCode('') }
+    catch (reason) { setError(reason.message) }
+    finally { setBusy(false) }
+  }
+  const input = (label, value, change, props = {}) => h('label', { className: 'bt-set-row' },
+    h('span', null, t(label)), h('input', { className: 'bt-input', value, onChange: e => change(e.target.value), ...props }))
+  const button = (label, endpoint, payload, disabled = false) => h('button', {
+    type: 'button', className: 'bt-soft bt-soft-sm', disabled: busy || disabled, onClick: () => { void run(endpoint, payload) },
+  }, t(label))
+  return h('section', { className: 'bt-set-section' },
+    h('p', null, t('Share chat history and model context with Kelivo. Sync never starts a model or a tool.')),
+    error || status?.lastError ? h('p', { className: 'bt-error', role: 'alert' }, error || status.lastError) : null,
+    h('div', { className: 'bt-set-card' },
+      input('Sync server', server, setServer, { type: 'url', placeholder: 'https://sync.example.com', disabled: status?.paired }),
+      !status?.paired ? input('Pairing code', code, setCode, { type: 'password', autoComplete: 'off' }) : null,
+      !status?.paired ? h('label', { className: 'bt-set-row' }, h('input', { type: 'checkbox', checked: localHttp, onChange: e => setLocalHttp(e.target.checked) }), t('Allow local HTTP for testing')) : null,
+      h('div', { className: 'bt-actions' }, status?.paired
+        ? [button('Sync now', 'sync-run', {}, false), button('Disconnect', 'sync-disconnect', {})]
+        : button('Pair', 'sync-pair', { server, code, localHttp }, !server || !code)),
+      status?.lastSuccess ? h('p', { role: 'status' }, `${t('Last synced')}: ${new Date(status.lastSuccess).toLocaleString()}`) : null),
+    status?.paired ? h('div', { className: 'bt-set-card' },
+      h('label', { className: 'bt-set-row' }, t('Share a Bot chat'), h('select', { className: 'bt-select', value: bot, onChange: e => setBot(e.target.value) },
+        h('option', { value: '' }, t('Choose a Bot…')), roster.bots.filter(b => !status.bindings.some(link => link.botId === b.id)).map(b => h('option', { key: b.id, value: b.id }, b.name)))),
+      button('Share chat', 'sync-share', { botId: bot }, !bot),
+      h('label', { className: 'bt-set-row' }, t('Import a phone chat'), h('select', { className: 'bt-select', value: conversation, onChange: e => setConversation(e.target.value) },
+        h('option', { value: '' }, t('Choose a conversation…')), status.conversations.map(c => h('option', { key: c.id, value: c.id }, c.title)))),
+      button('Import as a new Bot', 'sync-import', { conversationId: conversation }, !conversation),
+      status.bindings.map(link => h('p', { key: link.botId }, `${roster.bots.find(b => b.id === link.botId)?.name ?? 'Bot'} → ${link.title}${link.deleted ? ` (${t('Deleted on phone; desktop history retained')})` : ''}`))) : null,
+    h('p', { className: 'bt-set-hint' }, t('Use a configured Kelivo assistant to reply on your phone. Models, keys, tools and files stay on each device. DSH keeps its audit log when a phone message is edited or deleted.')))
+}
